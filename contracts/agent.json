{
  "chatRequest": {
    "messages": [{ "role": "user|assistant|system", "content": "string" }],
    "context": {
      "tab": "pitch|match|game|overview",
      "pitch": {
        "offside": {
          "reviewFrame": "pass_release",
          "timeline": {
            "sampleRateHz": 120,
            "frameCount": "number",
            "durationSeconds": "number",
            "passReleaseTimeSeconds": "number",
            "passReleaseFrameIndex": "number",
            "measurementReady": "boolean",
            "measurementSource": "simulation_proxy|three_d_pose",
            "samples": "Every 120 Hz frame with positions and assessment; the indexed pass-release sample is the sole ruling evidence"
          }
        }
      }
    }
  },
  "chatResponse": {
    "message": { "role": "assistant", "content": "string" },
    "actions": [],
    "toolCalls": [{ "name": "string", "input": {} }]
  },
  "adjudicateRequest": {
    "incidentId": "string",
    "offside": "Same offside evidence envelope as chatRequest.context.pitch.offside"
  },
  "sceneActions": [
    { "type": "camera.set", "preset": "broadcast|touchline|tactical|referee|free", "position": [0, 0, 0], "lookAt": [0, 0, 0] },
    { "type": "players.set", "players": [{ "id": "string", "team": "home|away", "position": [0, 0, 0] }] },
    { "type": "ball.set", "position": [0, 0, 0] },
    { "type": "arrow.add", "id": "string", "from": [0, 0, 0], "to": [0, 0, 0] },
    { "type": "arrow.clear" },
    { "type": "highlight", "target": "player|zone", "id": "string" },
    { "type": "incident.seek", "time": 0 },
    { "type": "pitch.overlay.set", "key": "skeleton|labels|trajectory|forces|dual", "enabled": true },
    { "type": "reset" }
  ]
}
